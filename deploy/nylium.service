[Unit]
Description=nylium
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/nylium
EnvironmentFile=/opt/nylium/.env
ExecStart=/opt/nylium/.venv/bin/nylium serve --host 127.0.0.1 --port 8474
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
